#!/bin/bash
# =====================================================================
# pre-push (AI guard) - global via core.hooksPath
# ---------------------------------------------------------------------
# Last line of defense before history leaves the machine. For every
# commit that this push would introduce, blocks when:
#   - the message mentions an AI tool or still carries an AI trailer;
#   - the message carries ANY Co-Authored-By (multiple authorship);
#   - author or committer name/email matches an AI tool or bot.
# The range comes from the stdin pairs (local_ref/local_sha and
# remote_ref/remote_sha), not from branch names or HEAD~1. Commits already
# reachable from another published ref are published history and are
# not judged again. Tracking refs of every update in this push are replaced
# by the SHAs from stdin. A missing remote object or a rev-list failure rejects
# the push. A remote_sha of zeros is a new ref, not an error.
# Then chains to the repository's own pre-push, re-feeding the original
# stdin so corporate hooks see the exact same ref lines.
# Never rewrites anything. Args: $1 remote, $2 url. Stdin: ref pairs.
# =====================================================================
set -u

HOOK_DIR=$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
# shellcheck source=lib/ai-guard.sh
. "$HOOK_DIR/lib/ai-guard.sh"

input=$(cat)

if ! ai_guard_maintenance && [ -n "$input" ]; then
  remote_name="${1:-}"
  remote_url="${2:-}"
  bad=""
  bad_state=""
  prep_skip=$(mktemp "${TMPDIR:-/tmp}/ai-guard-pre-push-skip.XXXXXX") || exit 1
  prep_auth=$(mktemp "${TMPDIR:-/tmp}/ai-guard-pre-push-auth.XXXXXX") || exit 1
  prep_err=$(mktemp "${TMPDIR:-/tmp}/ai-guard-pre-push-prep.XXXXXX") || exit 1
  if ! ai_guard_prepare_push "$remote_name" "$remote_url" "$input" "$prep_skip" "$prep_auth" 2>"$prep_err"; then
    detail=$(cat "$prep_err")
    rm -f "$prep_err"
    [ -n "$detail" ] || detail="remoto do push não identificado ou estado inconsistente"
    bad_state="
  ${detail}"
  else
    rm -f "$prep_err"
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "$local_sha" in
      *[!0]*) ;;
      *) continue ;;   # apagar a ref remota; zeros de 40 ou 64
    esac
    range_err=$(mktemp "${TMPDIR:-/tmp}/ai-guard-pre-push.XXXXXX") || {
      bad_state="$bad_state
  ${local_ref:-ref} -> ${remote_ref:-ref}: falha ao preparar a verificação"
      continue
    }
    if ! range=$(ai_guard_push_commits "$remote_name" "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" "$remote_url" "$prep_skip" "$prep_auth" 2>"$range_err"); then
      detail=$(cat "$range_err")
      rm -f "$range_err"
      [ -n "$detail" ] || detail="ref remota ausente ou estado inconsistente"
      bad_state="$bad_state
  ${local_ref} -> ${remote_ref}: ${detail}"
      continue
    fi
    rm -f "$range_err"
    for sha in $range; do
      msg=$(git log -1 --format=%B "$sha")
      ident=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$sha")
      why=""
      [ -n "$(ai_guard_violations "$msg")" ] && why="menção a IA"
      [ -z "$why" ] && printf '%s\n' "$msg" | grep -qiE "$AI_GUARD_STRIP_RE" && why="trailer de IA"
      [ -z "$why" ] && [ -n "$(ai_guard_coauthor_violations "$msg")" ] && why="coautoria"
      [ -z "$why" ] && printf '%s\n' "$ident" | grep -qiE "$AI_GUARD_IDENT_RE" && why="autor/committer bot ou ferramenta"
      if [ -n "$why" ]; then
        bad="$bad
  $(git log -1 --format='%h %s' "$sha")  [$why]"
      fi
    done
  done <<EOF
$input
EOF
  fi
  rm -f "$prep_skip" "$prep_auth"
  if [ -n "$bad_state" ] || [ -n "$bad" ]; then
    detail=""
    if [ -n "$bad_state" ]; then
      detail="${detail}
estado inconsistente — o push foi interrompido, sem tratar o intervalo como vazio:${bad_state}"
    fi
    if [ -n "$bad" ]; then
      detail="${detail}
commits novos, ainda fora dos outros remotos conhecidos:${bad}"
    fi
    ai_guard_block_message pre-push \
      "push interrompido; não reescreva commit que já está em algum remoto" "$detail"
    exit 1
  fi
fi

gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null)
repo_hook="$gitdir/hooks/pre-push"
if [ -n "$gitdir" ] && [ -x "$repo_hook" ]; then
  printf '%s\n' "$input" | "$repo_hook" "$@"
  exit $?
fi
exit 0
